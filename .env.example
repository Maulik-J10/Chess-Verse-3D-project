# CHESSVERSE 3D - Configuration Reference

# BACKEND (Render / Railway / Fly.io persistent WebSocket host)
PORT=4000
NODE_ENV=production
# Comma-separated frontend origins allowed for Socket.IO + HTTP CORS (or * for open access)
CORS_ORIGIN=https://chessverse3d.vercel.app

# FRONTEND (Local development uses localhost:4000; Vercel production MUST use your https:// backend URL)
VITE_SOCKET_URL=http://localhost:4000
